{
  "schema": "acan-demo-intent-edits/2",
  "order": "o-1",
  "decided_by": "coordinator, delegated by the owner",
  "note": "Written for the draft in run D:\\dev\\acan-takes\\d02t-fresh3-o1-20261101-022207 (scope-draft-o-1.json, rev 1, foreman draft d02t). That draft differs from the d02k draft: keep-redirect is absent, and its open choices are scope-shared and window-reset. Each edit names the draft item it acts on by id; draft_mapping maps each drafted id to the decision it follows. Items follow the coordinator decisions D1 to D19 in coordinator-decisions-d02t.json. take.ps1 applies scope_edits to the draft in order, then choice_rules to the open choices, then sends the result as one revise_scope, and logs each edit as a human step. An op whose id is not in the draft stops the take (fail closed). Nothing here is a verdict: the edits state the order's rules and the gate checks them.",
  "choice_rules": [
    {
      "id": "cr-bucket-scope",
      "question_match": "(?i)shared across (the|all) link API|shared across link routes",
      "option_label_match": "(?i)^Shared across all link API routes$",
      "when_no_option_matches": "fail",
      "decided_by": "coordinator, delegated by the owner",
      "reason": "The order says ten requests per 60 seconds on the link API, one budget for the API, not one per route. Recorded bucket-scope = shared (D19)."
    },
    {
      "id": "cr-window-reset",
      "question_match": "(?i)How does the 60-second window reset",
      "option_label_match": "(?i)^Fixed 60-second windows$",
      "when_no_option_matches": "fail",
      "decided_by": "coordinator, delegated by the owner",
      "reason": "D17 window-boundary (exclusive): a request exactly at 60 s starts a new window, so the window is fixed, not sliding. The window items anchor on the first match with duration 60000 ms and boundary exclusive; probe s17 is at 60000 ms."
    }
  ],
  "scope_edits": [
    {
      "op": "remove_may",
      "id": "limit-get-links",
